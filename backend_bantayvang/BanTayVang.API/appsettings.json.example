{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HeThongBanTayVang;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_RANDOM_256BIT_SECRET_NEVER_COMMIT_THIS",
    "Issuer": "BanTayVang.API",
    "Audience": "BanTayVang.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "RememberMeExpirationDays": 90,
    "RequireHttps": true,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "ClockSkewMinutes": 5
  },

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "your-app-password",
    "FromEmail": "noreply@bantayvang.vn",
    "FromName": "Hệ thống Kiểm tra nội bộ",
    "UseSsl": true,
    "EnableEmailSending": false
  },

  "AiGrading": {
    "Provider": "Gemini",
    "ApiKey": "REPLACE_WITH_YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.0-flash",
    "MaxRetries": 3,
    "TimeoutSeconds": 30
  },

  "AllowedHosts": "*"
}
